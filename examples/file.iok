import std::fs
import std::io

let file = fs::create("test.txt")

if file.write("Hello, World!\n") {
  io::println("File write successfully")
} els {
  io::println("Error")
  exit(1)
}

io::println("exists: " + fs::exists("test.txt"))
io::println("append: " + fs::append("test.txt", "Appended line\n"))

let files = fs::list_dir(".")
io::println("cwd entries: " + files.len())

let content = file.read()
io::println("{content}")
io::println("cleanup: " + fs::delete("test.txt"))