// Ping pong: W/S moves your paddle (left), Tab toggles bot-vs-bot mode.
// First to 5 wins. ESC or window close to quit.
// Run from repo root: cargo run -- --std ./std/ ./examples/raylib.iok

import "../extern/raylib_6.0/lib/raylib.iok" @ raylib

struct Ball {
    let pos
    let vel
    let r = 8

    fn move() => {
        self.pos.x = self.pos.x + self.vel.x
        self.pos.y = self.pos.y + self.vel.y
    }

    fn bounce() => {
        self.vel.y = 0 - self.vel.y
    }

    fn reflect() => {
        self.vel.x = (0 - self.vel.x) * 1.1
        if self.vel.x > 9 {
            self.vel.x = 9
        }
        if self.vel.x < 0 - 9 {
            self.vel.x = 0 - 9
        }
    }

    fn serve(cx, cy, dir) => {
        self.pos.x = cx
        self.pos.y = cy
        self.vel.x = dir * 4
        self.vel.y = 1.5
    }
}

struct Paddle {
    let x
    let y
    let w = 12
    let h = 90
    let speed = 6
    let score = 0
    let side = 1

    fn up() => {
        self.y = self.y - self.speed
    }

    fn down() => {
        self.y = self.y + self.speed
    }

    fn clamp() => {
        let max_y = raylib::screen_height() - self.h
        if self.y < 0 {
            self.y = 0
        }
        if self.y > max_y {
            self.y = max_y
        }
    }

    fn ai_move(ball) => {
        // only chase the ball once it crosses into this paddle's half
        if self.side * ball.pos.x > self.side * 400 {
            let target = ball.pos.y - self.h / 2
            let gap = target - self.y
            if gap > 0.5 {
                let step = gap * 0.2
                if step > self.speed {
                    step = self.speed
                }
                self.y = self.y + step
            } els {
                if gap < 0 - 0.5 {
                    let step = (0 - gap) * 0.2
                    if step > self.speed {
                        step = self.speed
                    }
                    self.y = self.y - step
                }
            }
        }
    }
}

fn hit_paddle(ball, paddle) => {
    let nx = ball.pos.x
    if nx < paddle.x {
        nx = paddle.x
    }
    if nx > paddle.x + paddle.w {
        nx = paddle.x + paddle.w
    }
    let ny = ball.pos.y
    if ny < paddle.y {
        ny = paddle.y
    }
    if ny > paddle.y + paddle.h {
        ny = paddle.y + paddle.h
    }
    let dx = ball.pos.x - nx
    let dy = ball.pos.y - ny
    ret dx * dx + dy * dy < ball.r * ball.r
}

raylib::init_window(800, 450, "IOk Pong")
raylib::set_target_fps(60)

let player = Paddle { x: 20, y: 180, w: 12, h: 90, speed: 6, score: 0, side: 0 - 1 }
let bot = Paddle { x: 768, y: 180, w: 12, h: 90, speed: 4.5, score: 0, side: 1 }
let ball = Ball { pos: raylib::vec2(400, 225), vel: raylib::vec2(4, 1.5), r: 8 }

let WIN_SCORE = 5
let ai_both = false
let p1_name = "You"
let p2_name = "Bot"

while !raylib::window_should_close() {
    if raylib::is_key_pressed(raylib::KEY_TAB) {
        if ai_both {
            ai_both = false
            p1_name = "You"
            p2_name = "Bot"
        } els {
            ai_both = true
            p1_name = "Left"
            p2_name = "Right"
        }
    }
    player.clamp()
    if ai_both {
        player.ai_move(ball)
    } els {
        if raylib::is_key_down(raylib::KEY_W) || raylib::is_key_down(raylib::KEY_UP) {
            player.up()
        }
        if raylib::is_key_down(raylib::KEY_S) || raylib::is_key_down(raylib::KEY_DOWN) {
            player.down()
        }
    }
    bot.ai_move(ball)
    bot.clamp()

    ball.move()

    if ball.pos.y < ball.r {
        ball.pos.y = ball.r
        ball.bounce()
    }
    if ball.pos.y > 450 - ball.r {
        ball.pos.y = 450 - ball.r
        ball.bounce()
    }

    if hit_paddle(ball, player) && ball.vel.x < 0 {
        ball.reflect()
    }
    if hit_paddle(ball, bot) && ball.vel.x > 0 {
        ball.reflect()
    }

    if ball.pos.x < 0 {
        bot.score = bot.score + 1
        ball.serve(400, 225, 0 - 1)
    }
    if ball.pos.x > 800 {
        player.score = player.score + 1
        ball.serve(400, 225, 1)
    }

    raylib::begin_drawing()
    raylib::clear_background(raylib::color(20, 20, 30))
    raylib::draw_line(400, 0, 400, 450, raylib::color(90, 90, 110))
    raylib::draw_rectangle(player.x, player.y, player.w, player.h, raylib::color(80, 200, 120))
    raylib::draw_rectangle(bot.x, bot.y, bot.w, bot.h, raylib::color(120, 140, 230))
    raylib::draw_circle_v(ball.pos, ball.r, raylib::color(255, 80, 80))
    raylib::draw_text(p1_name + ": " + player.score + "   " + p2_name + ": " + bot.score, 310, 20, 24, raylib::color(255, 255, 255))
    raylib::draw_fps(10, 10)

    if player.score >= WIN_SCORE {
        raylib::draw_text(p1_name + " wins!", 320, 200, 40, raylib::color(80, 200, 120))
    }
    if bot.score >= WIN_SCORE {
        raylib::draw_text(p2_name + " wins!", 320, 200, 40, raylib::color(255, 80, 80))
    }

    raylib::end_drawing()

    if player.score >= WIN_SCORE || bot.score >= WIN_SCORE {
        break
    }
}

raylib::close_window()
write("closed\n")
