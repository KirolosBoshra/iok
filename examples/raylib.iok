// Ping pong: W/S moves your paddle (left), Tab toggles bot-vs-bot mode.
// First to 5 wins. ESC or window close to quit.
// Run from repo root: cargo run -- --std ./std/ ./examples/raylib.iok

import "../extern/raylib_6.0/lib/raylib.iok" @ rl

struct Ball {
    let pos = rl::vec2(0, 0)
    let vel = rl::vec2(0, 0)
    let r = 8

    fn new() => {
        ret Ball {
            pos: rl::vec2(400, 225), 
            vel: rl::vec2(4, 1.5), 
            r: 8 
        }
    }

    fn move() => {
        self.pos.x = self.pos.x + self.vel.x
        self.pos.y = self.pos.y + self.vel.y
    }

    fn bounce() => {
        self.vel.y = 0 - self.vel.y
    }

    fn reflect() => {
        self.vel.x = (0 - self.vel.x) * 1.1
        if self.vel.x > 9 {
            self.vel.x = 9
        }
        if self.vel.x < 0 - 9 {
            self.vel.x = 0 - 9
        }
    }

    fn serve(cx, cy, dir) => {
        self.pos.x = cx
        self.pos.y = cy
        self.vel.x = dir * 4
        self.vel.y = 1.5
    }
}

struct Paddle {
    let rec = rl::rect(0, 0, 0, 0)
    let speed = 6
    let score = 0
    let side = 1

    fn new(x, y, spd, sd) => {
        ret Paddle {
            rec: rl::rect(x, y, 12, 90),
            speed: spd,
            score: 0,
            side: sd,
        }
    }

    fn up() => {
        self.rec.y = self.rec.y - self.speed
    }

    fn down() => {
        self.rec.y = self.rec.y + self.speed
    }

    fn clamp() => {
        let max_y = rl::screen_height() - self.rec.height
        if self.rec.y < 0 {
            self.rec.y = 0
        }
        if self.rec.y > max_y {
            self.rec.y = max_y
        }
    }

    fn ai_move(ball) => {
        // only chase the ball once it crosses into this paddle's half
        if self.side * ball.pos.x > self.side * 400 {
            let target = ball.pos.y - self.rec.height / 2
            let gap = target - self.rec.y
            if gap > 0.5 {
                let step = gap * 0.2
                if step > self.speed {
                    step = self.speed
                }
                self.rec.y = self.rec.y + step
            } els {
                if gap < 0 - 0.5 {
                    let step = (0 - gap) * 0.2
                    if step > self.speed {
                        step = self.speed
                    }
                    self.rec.y = self.rec.y - step
                }
            }
        }
    }
}

fn hit_paddle(ball, paddle) => {
    let nx = ball.pos.x
    if nx < paddle.rec.x {
        nx = paddle.rec.x
    }
    if nx > paddle.rec.x + paddle.rec.width {
        nx = paddle.rec.x + paddle.rec.width
    }
    let ny = ball.pos.y
    if ny < paddle.rec.y {
        ny = paddle.rec.y
    }
    if ny > paddle.rec.y + paddle.rec.height {
        ny = paddle.rec.y + paddle.rec.height
    }
    let dx = ball.pos.x - nx
    let dy = ball.pos.y - ny
    ret dx * dx + dy * dy < ball.r * ball.r
}

rl::init_window(800, 450, "IOk Pong")
rl::set_target_fps(60)

let player = Paddle::new(20, 180, 6, -1)
let bot = Paddle::new(768, 180, 4.5, 1)
let ball = Ball::new()

let WIN_SCORE = 5
let ai_both = false
let p1_name = "You"
let p2_name = "Bot"

while !rl::window_should_close() {
    if rl::is_key_pressed(rl::KEY_TAB) {
        if ai_both {
            ai_both = false
            p1_name = "You"
            p2_name = "Bot"
            player.speed = 6
        } els {
            ai_both = true
            p1_name = "Left"
            p2_name = "Right"
            player.speed = 4.5
        }
    }
    player.clamp()
    if ai_both {
        player.ai_move(ball)
    } els {
        if rl::is_key_down(rl::KEY_W) || rl::is_key_down(rl::KEY_UP) {
            player.up()
        }
        if rl::is_key_down(rl::KEY_S) || rl::is_key_down(rl::KEY_DOWN) {
            player.down()
        }
    }
    bot.ai_move(ball)
    bot.clamp()

    ball.move()

    if ball.pos.y < ball.r {
        ball.pos.y = ball.r
        ball.bounce()
    }
    if ball.pos.y > 450 - ball.r {
        ball.pos.y = 450 - ball.r
        ball.bounce()
    }

    if hit_paddle(ball, player) && ball.vel.x < 0 {
        ball.reflect()
    }
    if hit_paddle(ball, bot) && ball.vel.x > 0 {
        ball.reflect()
    }

    if ball.pos.x < 0 {
        bot.score = bot.score + 1
        ball.serve(400, 225, 0 - 1)
    }
    if ball.pos.x > 800 {
        player.score = player.score + 1
        ball.serve(400, 225, 1)
    }

    rl::begin_drawing()
    rl::clear_background(rl::color(20, 20, 30))
    rl::draw_line(400, 0, 400, 450, rl::color(90, 90, 110))
    rl::draw_rectangle_rec(player.rec, rl::color(80, 200, 120))
    rl::draw_rectangle_rec(bot.rec, rl::color(120, 140, 230))
    rl::draw_circle_v(ball.pos, ball.r, rl::color(255, 80, 80))
    let score_line = p1_name + ": " + player.score + "   " + p2_name + ": " + bot.score
    rl::draw_text(score_line, 400 - rl::measure_text(score_line, 24) / 2, 20, 24, rl::color(255, 255, 255))
    rl::draw_fps(10, 10)

    if player.score >= WIN_SCORE {
        let win_line = p1_name + " wins!"
        rl::draw_text(win_line, 400 - rl::measure_text(win_line, 40) / 2, 200, 40, rl::color(80, 200, 120))
    }
    if bot.score >= WIN_SCORE {
        let win_line = p2_name + " wins!"
        rl::draw_text(win_line, 400 - rl::measure_text(win_line, 40) / 2, 200, 40, rl::color(255, 80, 80))
    }

    rl::end_drawing()

    if player.score >= WIN_SCORE || bot.score >= WIN_SCORE {
        break
    }
}

rl::close_window()
