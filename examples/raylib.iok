// One-player ping pong: W/S moves your paddle (left), the bot plays the right side.
// First to 5 wins. ESC or window close to quit.
// Run from repo root: cargo run -- --std ./std/ ./examples/raylib.iok

import "../extern/raylib-6.0_win64_msvc16/lib/raylib.iok" @ raylib

struct Ball {
    let x
    let y
    let vx
    let vy
    let r = 8

    fn move() => {
        self.x = self.x + self.vx
        self.y = self.y + self.vy
    }

    fn bounce() => {
        self.vy = 0 - self.vy
    }

    fn reflect() => {
        self.vx = 0 - self.vx
        self.vx = self.vx * 1.1
        if self.vx > 9 {
            self.vx = 9
        }
        if self.vx < 0 - 9 {
            self.vx = 0 - 9
        }
    }

    fn serve(cx, cy, dir) => {
        self.x = cx
        self.y = cy
        self.vx = dir * 4
        self.vy = 1.5
    }
}

struct Paddle {
    let x
    let y
    let w = 12
    let h = 90
    let speed = 6
    let score = 0

    fn up() => {
        self.y = self.y - self.speed
    }

    fn down() => {
        self.y = self.y + self.speed
    }

    fn clamp() => {
        let max_y = raylib::screen_height() - self.h
        if self.y < 0 {
            self.y = 0
        }
        if self.y > max_y {
            self.y = max_y
        }
    }

    fn ai_move(ball) => {
        // only chase the ball once it crosses into the bot's half
        if ball.x > 400 {
            let target = ball.y - self.h / 2
            // dead zone: stop within one step of target, else it oscillates
            if self.y + self.speed < target {
                self.y = self.y + self.speed
            } els {
                if self.y - self.speed > target {
                    self.y = self.y - self.speed
                }
            }
        }
    }
}

fn hit_paddle(ball, paddle) => {
    let nx = ball.x
    if nx < paddle.x {
        nx = paddle.x
    }
    if nx > paddle.x + paddle.w {
        nx = paddle.x + paddle.w
    }
    let ny = ball.y
    if ny < paddle.y {
        ny = paddle.y
    }
    if ny > paddle.y + paddle.h {
        ny = paddle.y + paddle.h
    }
    let dx = ball.x - nx
    let dy = ball.y - ny
    ret dx * dx + dy * dy < ball.r * ball.r
}

raylib::init_window(800, 450, "IOk Pong")
raylib::set_target_fps(60)

let player = Paddle { x: 20, y: 180, w: 12, h: 90, speed: 6, score: 0 }
let bot = Paddle { x: 768, y: 180, w: 12, h: 90, speed: 4.5, score: 0 }
let ball = Ball { x: 400, y: 225, vx: 4, vy: 1.5, r: 8 }

let WIN_SCORE = 5

while !raylib::window_should_close() {
    if raylib::is_key_down(raylib::KEY_W) {
        player.up()
    }
    if raylib::is_key_down(raylib::KEY_S) {
        player.down()
    }
    player.clamp()
    bot.ai_move(ball)
    bot.clamp()

    ball.move()

    if ball.y < ball.r {
        ball.y = ball.r
        ball.bounce()
    }
    if ball.y > 450 - ball.r {
        ball.y = 450 - ball.r
        ball.bounce()
    }

    if hit_paddle(ball, player) && ball.vx < 0 {
        ball.reflect()
    }
    if hit_paddle(ball, bot) && ball.vx > 0 {
        ball.reflect()
    }

    if ball.x < 0 {
        bot.score = bot.score + 1
        ball.serve(400, 225, 0 - 1)
    }
    if ball.x > 800 {
        player.score = player.score + 1
        ball.serve(400, 225, 1)
    }

    raylib::begin_drawing()
    raylib::clear_background(raylib::color(20, 20, 30))
    raylib::draw_line(400, 0, 400, 450, raylib::color(90, 90, 110))
    raylib::draw_rectangle(player.x, player.y, player.w, player.h, raylib::color(80, 200, 120))
    raylib::draw_rectangle(bot.x, bot.y, bot.w, bot.h, raylib::color(120, 140, 230))
    raylib::draw_circle(ball.x, ball.y, ball.r, raylib::color(255, 80, 80))
    raylib::draw_text("P1: " + player.score + "   P2: " + bot.score, 310, 20, 24, raylib::color(255, 255, 255))
    raylib::draw_fps(10, 10)

    if player.score >= WIN_SCORE {
        raylib::draw_text("You win!", 320, 200, 40, raylib::color(80, 200, 120))
    }
    if bot.score >= WIN_SCORE {
        raylib::draw_text("Bot wins!", 320, 200, 40, raylib::color(255, 80, 80))
    }

    raylib::end_drawing()

    if player.score >= WIN_SCORE || bot.score >= WIN_SCORE {
        break
    }
}

raylib::close_window()
write("closed\n")