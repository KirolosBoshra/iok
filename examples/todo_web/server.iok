// IOk web TODO app - showcases sockets, file storage, structs, lists, strings
//
// Run:
//   ./target/release/iok --std ./std/ ./examples/todo_web/server.iok
// Then open http://127.0.0.1:8081/ in your browser.
//
// Tasks live in todo.txt next to this script (100 fixed-size records of 64
// bytes each - the whole file is rewritten on every change, since the file
// API can't truncate).

import std::io
import std::fs
import std::net

let PORT = 8081
let MAX_TASKS = 100
let TITLE_W = 57
let RECORD = 64
let FILE = "todo.txt"

// ---------------------------------------------------------------------------
// Task model
// ---------------------------------------------------------------------------

struct Task {
  let title
  let done

  fn new(title, done=false) => {
    ret Task {
      title: title,
      done: done,
    }
  }
}

// Pad or truncate the title to exactly TITLE_W chars
fn field(title) => {
  if title.len() >= TITLE_W {
    ret title.substr(0, TITLE_W)
  }
  ret title + " " * (TITLE_W - title.len())
}

fn record_of(task) => {
  let flag = "0"
  if task.done {
    flag = "1"
  }
  ret field(task.title) + "|" + flag + "\n" + " " * (RECORD - TITLE_W - 3)
}

fn title_at(content, off) => {
  // the record title, trimmed of trailing padding spaces
  ret content.substr(off, TITLE_W).trim()
}

fn load_tasks() => {
  let tasks = []
  let f = fs::open(FILE)
  let content = f.read()
  let off = 0
  while off + RECORD <= content.len() {
    let flag = content[off + TITLE_W + 1]
    if flag == "1" {
      tasks.push(Task::new(title_at(content, off), true))
    } els {
      if flag == "0" {
        tasks.push(Task::new(title_at(content, off)))
      }
    }
    off += RECORD
  }
  ret tasks
}

fn save_tasks(tasks) => {
  let buf = ""
  let i = 0
  while i < MAX_TASKS {
    if i < tasks.len() {
      buf += record_of(tasks[i])
    } els {
      buf += " " * RECORD
    }
    i++
  }
  let f = fs::open(FILE)
  f.write_at(buf, 0)
}

fn remove_at(tasks, idx) => {
  let out = []
  let i = 0
  while i < tasks.len() {
    if i != idx {
      out.push(tasks[i])
    }
    i++
  }
  ret out
}

// ---------------------------------------------------------------------------
// String helpers
// ---------------------------------------------------------------------------

fn hex_digit(c) => {
  let d = c.ord(0)
  if d >= 48 && d <= 57 {
    ret d - 48
  }
  if d >= 65 && d <= 70 {
    ret d - 55
  }
  if d >= 97 && d <= 102 {
    ret d - 87
  }
  ret -1
}

fn decode(s) => {
  // form-encoded: '+' means space, %XX is one byte
  let out = ""
  let i = 0
  while i < s.len() {
    if s[i] == "+" {
      out += " "
      i++
    } elsif s[i] == "%" {
      let hi = hex_digit(s.substr(i + 1, 1))
      let lo = hex_digit(s.substr(i + 2, 1))
      if hi >= 0 && lo >= 0 {
        out += chr(hi * 16 + lo)
        i += 3
      } els {
        out += s[i]
        i++
      }
    } els {
      out += s[i]
      i++
    }
  }
  ret out
}

fn escape(s) => {
  // minimal HTML escaping so task titles can't inject markup
  ret s.replace("&", "&amp;").replace("<", "&lt;")
}

// Extract the path from a request line: "GET /add?task=x HTTP/1.1" -> "/add?task=x"
fn path_of(line) => {
  ret line.split(" ")[1]
}

// Value of key= inside the query string, or ""
fn param(path, key) => {
  let k = key + "="
  for p -> path.split("?")[1].split("&") {
    if p.substr(0, k.len()) == k {
      ret p.substr(k.len(), p.len() - k.len())
    }
  }
  ret ""
}

fn parse_index(s) => {
  let n = s.to_number()
  if n == null {
    ret 0
  }
  ret n
}

// ---------------------------------------------------------------------------
// HTTP
// ---------------------------------------------------------------------------

fn response(status, body) => {
  ret "HTTP/1.1 " + status + "\r\nContent-Length: " + body.len() +
    "\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\n\r\n" + body
}

fn redirect() => {
  ret "HTTP/1.1 302 Found\r\nLocation: /\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
}

fn not_found() => {
  ret "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
}

fn page(tasks) => {
  let rows = ""
  let i = 0
  while i < tasks.len() {
    let mark = "[ ]"
    if tasks[i].done {
      mark = "[x]"
    }
    rows += "  <li><span>" + mark + " " + escape(tasks[i].title) + "</span>" +
      "<a href='/toggle?index=" + i + "'>toggle</a>" +
      "<a href='/delete?index=" + i + "'>delete</a></li>\n"
    i++
  }
  if rows == "" {
    rows = "  <li class='empty'>No tasks yet - add one above!</li>\n"
  }
  let body =
    "<!DOCTYPE html>\n<html>\n<head>\n<meta charset='utf-8'>\n" +
    "<meta name='viewport' content='width=device-width, initial-scale=1'>\n" +
    "<title>IOk TODO</title>\n" +
    "<style>\n" +
    "body { font-family: system-ui, sans-serif; max-width: 520px; margin: 3rem auto; padding: 0 1rem; background: #1b1f2a; color: #e8e8ec; }\n" +
    "h1 { color: #7aa2f7; margin-bottom: 0; }\n" +
    "p.sub { color: #6a7080; font-size: .85rem; margin-top: .25rem; }\n" +
    "form { display: flex; gap: .5rem; margin: 1.5rem 0; }\n" +
    "input { flex: 1; padding: .6rem; border: 1px solid #3a3f52; border-radius: 6px; background: #262b3a; color: #e8e8ec; }\n" +
    "button { padding: .6rem 1rem; border: none; border-radius: 6px; background: #7aa2f7; color: #1b1f2a; font-weight: bold; cursor: pointer; }\n" +
    "ul { list-style: none; padding: 0; }\n" +
    "li { display: flex; align-items: center; gap: .75rem; padding: .55rem .75rem; margin-bottom: .5rem; background: #262b3a; border-radius: 6px; }\n" +
    "li span { flex: 1; }\n" +
    "li a { color: #7aa2f7; font-size: .85rem; text-decoration: none; }\n" +
    "li a:last-child { color: #f7768e; }\n" +
    "li.empty { color: #6a7080; font-style: italic; }\n" +
    "</style>\n</head>\n<body>\n" +
    "<h1>IOk TODO</h1>\n<p class='sub'>served by IOk from " + FILE + "</p>\n" +
    "<form action='/add' method='GET'>\n" +
    "  <input type='text' name='task' placeholder='New task...' maxlength='57' required>\n" +
    "  <button type='submit'>Add</button>\n" +
    "</form>\n<ul>\n" + rows + "</ul>\n</body>\n</html>\n"
  ret response("200 OK", body)
}

// Build a response for one request; todo.txt is the only state
fn handle(request_line) => {
  let path = path_of(request_line)
  let tasks = load_tasks()
  if path == "/" {
    ret page(tasks)
  }
  if path.includes("/add?") {
    let title = decode(param(path, "task"))
    if title.len() > 0 {
      tasks.push(Task::new(title))
      save_tasks(tasks)
    }
    ret redirect()
  }
  if path.includes("/toggle?") {
    let idx = parse_index(param(path, "index"))
    if idx < tasks.len() {
      if tasks[idx].done {
        tasks[idx].done = false
      } els {
        tasks[idx].done = true
      }
      save_tasks(tasks)
    }
    ret redirect()
  }
  if path.includes("/delete?") {
    let idx = parse_index(param(path, "index"))
    if idx < tasks.len() {
      tasks = remove_at(tasks, idx)
      save_tasks(tasks)
    }
    ret redirect()
  }
  ret not_found()
}

// ---------------------------------------------------------------------------
// Server loop
// ---------------------------------------------------------------------------

io::println("IOk TODO server on 127.0.0.1:" + PORT + "  (Ctrl+C to stop)")
io::println("Open http://127.0.0.1:" + PORT + "/ in your browser")

let server = net::bind("127.0.0.1", PORT)
if server == null {
  io::println("Failed to bind port " + PORT + " - already in use?")
  exit()
} els {
  while true {
    let raw = server.accept()
    let client = net::create_socket(raw)
    if client != null {
      let request_line = client.read()
      if request_line != "" {
        // drain the headers up to the empty line
        let line = client.read()
        while line != "" {
          line = client.read()
        }
        let resp = handle(request_line)
        client.write(resp)
      }
      client.close()
    }
  }
  server.close()
}
