// raylib wrapper for IOk — thin FFI bindings for raylib.dll
// Loads ./extern/raylib_6.0/lib/raylib.dll (repo root), falls back to bare "raylib.dll" (PATH / exe dir)

import std::ffi

let lib = ffi::load("./extern/raylib_6.0/lib/raylib.dll")
if lib == null {
    lib = ffi::load("raylib.dll")
}

if lib == null {
    write("raylib.dll not found — copy it next to iok.exe or add its dir to PATH\n")
    exit(1)
}

// structs (layouts match raylib 6.0; numeric fields only)
ffi::def_struct("Color", "r:u8, g:u8, b:u8, a:u8")
ffi::def_struct("Vector2", "x:f32, y:f32")
ffi::def_struct("Vector3", "x:f32, y:f32, z:f32")
ffi::def_struct("Vector4", "x:f32, y:f32, z:f32, w:f32")
ffi::def_struct("Rectangle", "x:f32, y:f32, width:f32, height:f32")
ffi::def_struct("Texture2D", "id:u32, width:i32, height:i32, mipmaps:i32, format:i32")

fn color(r, g, b, a=255) => ret ffi::struct_val("Color", [r, g, b, a])
fn vec2(x, y) => ret ffi::struct_val("Vector2", [x, y])
fn vec3(x, y, z) => ret ffi::struct_val("Vector3", [x, y, z])
fn vec4(x, y, z, w) => ret ffi::struct_val("Vector4", [x, y, z, w])
fn rect(x, y, w, h) => ret ffi::struct_val("Rectangle", [x, y, w, h])

// constants
let PI = 3.141592653589793
let DEG2RAD = PI / 180
let RAD2DEG = 180 / PI

