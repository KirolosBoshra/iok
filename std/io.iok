fn format(str) => {
  let output = ""

  for part -> str.split("{") {
    let bits = part.split("}")
    if bits.len() == 2 {
      output += __get_var_from_str(bits[0], true) + bits[1]
    } els {
      output += part
    }
  }

  ret output
}

fn print(str) => {
  let out = format(str)
  write(out)
}

fn println(str) => print(str+"\n")
